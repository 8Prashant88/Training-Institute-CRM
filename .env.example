# Runtime PostgreSQL connection
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres"

# Direct PostgreSQL connection for migrations
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"

# Existing server configuration
CRM_INTERNAL_API_KEY="replace-with-a-private-value"
CRM_REGION="Nepal"

# Supabase Authentication
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="your-publishable-key"

# Supabase secret key (Project Settings -> API -> Secret keys). Server-only,
# never expose with a NEXT_PUBLIC_ prefix. Required for admin-only actions
# such as creating counselor/admin accounts from the People page.
SUPABASE_SECRET_KEY="sb_secret_your-secret-key"

# Email notifications - server only
RESEND_API_KEY="re_your-api-key"
CRM_NOTIFICATION_EMAIL="admin@example.com"
CRM_EMAIL_FROM="CRM <notifications@yourdomain.com>"